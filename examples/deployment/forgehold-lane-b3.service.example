# INACTIVE PUBLIC REFERENCE; do not install. Paths, identities and pins are examples.
[Unit]
ConditionPathExists=/nonexistent/forgehold-public-example-disabled
Description=Forgehold lane B3 Preloop engine (isolated home, localhost only)
Requires=forgehold-lane-b3.socket
After=forgehold-lane-b3.socket network-online.target
StartLimitIntervalSec=1d
StartLimitBurst=1

[Service]
Type=simple
ExecStart=@@FH_PILOT_DIR@@/.local/bin/preloop serve
WorkingDirectory=@@FH_PILOT_DIR@@
Environment=PRELOOP_HOME=@@FH_PILOT_DIR@@/.preloop
Environment=PRELOOP_STORE_URL=@@FH_PILOT_DIR@@/.preloop/state-fh-b3/preloop.db
LoadCredential=github-app-key:@@FH_APP_KEY_FILE@@
Environment=PRELOOP_GITHUB_APP_ID=@@FH_APP_ID@@
Environment=PRELOOP_GITHUB_APP_PEM_FILE=%d/github-app-key
UnsetEnvironment=PRELOOP_GITHUB_APP_PEM PRELOOP_GITHUB_APP_PRIVATE_KEY PRELOOP_GITHUB_APP_PRIVATE_KEY_PATH
Environment=HOME=@@FH_PILOT_DIR@@
Environment=XDG_DATA_HOME=@@FH_PILOT_DIR@@/.local/share
Environment=XDG_CONFIG_HOME=@@FH_PILOT_DIR@@/.config
Environment=XDG_CACHE_HOME=@@FH_PILOT_DIR@@/.cache
Environment=XDG_STATE_HOME=@@FH_PILOT_DIR@@/.local/state
Environment=XDG_RUNTIME_DIR=@@FH_PILOT_DIR@@/run
Environment=SMOLVM_DATA_DIR=@@FH_PILOT_DIR@@/.preloop/smolvm-fh-b3
Environment=SMOLVM_EGRESS_FLOOR=strict
Environment=PATH=@@FH_PILOT_DIR@@/fh-b3-control/bin:@@FH_PILOT_DIR@@/.local/bin:/usr/bin:/bin
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
Environment=PRELOOP_SMOLVM_RELEASE_VERSION=1.19.0
Environment=PRELOOP_LISTEN=127.0.0.1:9090
Environment=PRELOOP_RUNNER_POOL_ENABLED=true
Environment=PRELOOP_RUNNER_POOL_SIZE=0
Environment=PRELOOP_RUNNER_CPUS=1
Environment=PRELOOP_RUNNER_MEMORY_MIB=3072
Environment=PRELOOP_RUNNER_STORAGE_GB=20
Environment=PRELOOP_RUNNER_MIN_FREE_DISK_GB=64
Environment=PRELOOP_RUNNER_LABELS=X64,forgehold
Environment=PRELOOP_USE_FORK=false
Environment=PRELOOP_RUNNER_BASE_IMAGE=@@FH_PILOT_DIR@@/images/preloop-ubuntu-24.04-x86_64
Environment=PRELOOP_USE_PACKED_GOLDEN=true
Environment=SMOLVM_KRUN_LOG_LEVEL=1
Environment=PRELOOP_GOLDEN_URL=https://github.com/preloopdev/preloop/releases/download/v0.33.9/preloop-ubuntu-24.04-x86_64
CPUAffinity=3
Restart=no
RuntimeMaxSec=480s
TimeoutStopSec=15s
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectClock=true
LockPersonality=true
RestrictRealtime=true
CapabilityBoundingSet=
ReadWritePaths=@@FH_PILOT_DIR@@
ReadOnlyPaths=@@FH_PILOT_DIR@@/.local/bin @@FH_PILOT_DIR@@/.local/lib
ReadOnlyPaths=@@FH_PILOT_DIR@@/.preloop/smolvm @@FH_PILOT_DIR@@/images @@FH_PILOT_DIR@@/.preloop/vms @@FH_PILOT_DIR@@/.smolvm/smolvm @@FH_PILOT_DIR@@/.smolvm/smolvm-bin @@FH_PILOT_DIR@@/.smolvm/lib @@FH_PILOT_DIR@@/attempt3-control/bin @@FH_PILOT_DIR@@/attempt4-control/bin @@FH_PILOT_DIR@@/attempt5-control/bin @@FH_PILOT_DIR@@/attempt6-control/bin @@FH_PILOT_DIR@@/attempt7-control/bin @@FH_PILOT_DIR@@/attempt8-control/bin @@FH_PILOT_DIR@@/fh-b3-control/bin

[Install]
WantedBy=default.target
