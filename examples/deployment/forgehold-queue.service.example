# INACTIVE PUBLIC REFERENCE; do not install. Paths, identities and pins are examples.
[Unit]
ConditionPathExists=/nonexistent/forgehold-public-example-disabled
Description=Forgehold standing queue @@FH_PACKET_NAME@@ (one attempt at a time)
ConditionPathExists=!@@FH_QUEUE_DIR@@/STOP
ConditionPathExists=!@@FH_QUEUE_DIR@@/SUSPENDED

[Service]
Type=simple
ExecStart=/usr/bin/bash @@FH_PACKET_DIR@@/queue_run.sh
Restart=no
KillMode=process
SendSIGKILL=no
TimeoutStopSec=30min
