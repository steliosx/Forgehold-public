#!/bin/bash
# INACTIVE PUBLIC REFERENCE. Configure and review a separate deployment packet.
printf "%s\n" "Reference example only; execution is disabled." >&2
exit 64

set -u
PH=/srv/forgehold/pilot
EXPIRY=${FH_EXPIRY:?}; SHA=${FH_COMMIT:?}; REPO=${FH_REPO:?}; WF=${FH_WORKFLOW:?}; WF_SHA=${FH_WORKFLOW_SHA256:?}
JOB=${FH_JOB:?}; GREF=${FH_REF:?}
[[ $EXPIRY =~ ^[0-9]{10}$ && $SHA =~ ^[0-9a-f]{40}$ && $REPO =~ ^[A-Za-z0-9_.-]{1,100}$ && $REPO != . && $REPO != ..
   && $WF =~ ^[A-Za-z0-9_.-]{1,100}\.ya?ml$ && $WF_SHA =~ ^[0-9a-f]{64}$ && $JOB =~ ^[A-Za-z0-9_-]{1,64}$
   && $GREF =~ ^[A-Za-z0-9_][A-Za-z0-9_.-]*(/[A-Za-z0-9_][A-Za-z0-9_.-]*)*$ && ${#GREF} -le 100 && $GREF != *..*
   && $GREF != refs/* && $GREF != *.lock && $GREF != */.* ]] || { echo "REFUSED: input environment invalid" >&2; exit 2; }
NAME=preloop-runner-0-1
PACK=$PH/.preloop/vms/preloop-example-images-preloop-ubuntu-24.04-x86_64-x86_64-59e464339594c0cffabcf6ee7ff4227a157bd607ce77e2e000e8304ae008c92a
PERMIT=$PH/fh-b3-control/create-consumed
TOKEN=${FH_TOKEN:?FH_TOKEN not set by run_fh_b3.sh}
HOLD=$PH/fh-b3-control/HOLD-$TOKEN
CUST="/usr/bin/python3.14 -I /srv/forgehold/packet/fh_custody.py"
SCAN="/usr/bin/python3.14 -I /srv/forgehold/packet/fh_hostscan.py"
WFC="/usr/bin/python3.14 -I /srv/forgehold/packet/fh_workflow.py"
ZHOLD=$PH/attempt3-control/HOLD
REF=engine-token-4d91f1065f28b6790bafae4fefae9a47445405252a1964a0049093edbc88bda9
STOPS='PILOT_CREATE_GATE|packed golden fork base unavailable|building golden for environment|fork base busy; creating runner independently|falling back to independent OCI creation|install hosted apt baseline|on-demand runner failed|on-demand runner slot error|Stale file handle|building its golden locally|downloading packed golden|removed orphaned machine data dir|IrqsExhausted|runs-on unsatisfiable'
UUID_RE='^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$'

b() { local s=$1; shift; [ "$s" -ge 1 ] || return 124; timeout -k 2 "$s" "$@"; }
log() { echo "$(date -u +%T.%3N) $*" >> "$L"; }
pl_status()   { b "$1" env -i bash --noprofile --norc -c '. /srv/forgehold/pilot/env.sh; exec preloop status --json'; }
pl_cancel()   { [[ $2 =~ $UUID_RE ]] || return 9
                b "$1" env -i RUNID="$2" bash --noprofile --norc -c '. /srv/forgehold/pilot/env.sh; exec preloop cancel "$RUNID"'; }
pl_machines() { b "$1" env -i bash --noprofile --norc -c '. /srv/forgehold/pilot/env.sh; export SMOLVM_DATA_DIR=/srv/forgehold/pilot/.preloop/smolvm-fh-b3; exec smolvm machine ls --json'; }
lab_machines(){ b "$1" /srv/forgehold/operator/.local/bin/smolvm machine ls --json; }
journal()     { b "$1" journalctl --user -u forgehold-lane-b3 --no-pager -o cat --since "$SINCE UTC"; }
empty_json_list() { python3 -I -c 'import json,sys; d=json.loads(sys.stdin.read()); sys.exit(0 if d == [] else 1)'; }
present() { local o; o=$(b 3 $SCAN procs "$1") || { echo 99; return; }; [ "${o%% *}" = 0 ] && echo 0 || echo 1; }
vm_count() { local o; o=$(b 5 $SCAN procs 'libkrun VM') || { echo 99; return; }; echo "${o%% *}"; }
vm_foreign() { local o; o=$(b 5 $SCAN procs 'libkrun VM') && echo "${o##* }" || echo unread; }
napi() { local s=$1 path=$2 out=$3 code rc
         code=$( { printf 'Authorization: Bearer '; b 10 secret-tool lookup service preloop username "$REF"; printf '\n'; } \
           | b "$s" curl -sS -m "$s" -o "$out" -w '%{http_code}' -H @- -H 'Accept: application/json' "http://127.0.0.1:9090$path" 2>>"$L"); rc=$?
         log "native GET $path rc=$rc http=${code:-none}"; [ "$rc" = 0 ] && [ "$code" = 200 ]; }
owned() { python3 -I -c 'import hashlib,json,sys
d=json.load(open(sys.argv[1])); s=d.get("submission") or {}
pre={x.get("run_id") for x in json.load(open(sys.argv[4]))}
repo,wf,wfsha,job=sys.argv[5],sys.argv[6],sys.argv[7],sys.argv[8]
y=s.get("workflow_yaml")
ok=(d.get("run_id")==sys.argv[2] and s.get("repository")=="example-owner/"+repo
    and (s.get("workflow_file")==wf or str(s.get("workflow_path","")).endswith("/"+wf))
    and sys.argv[3] in (s.get("sha"), s.get("resolved_sha")) and sys.argv[2] not in pre
    and isinstance(y,str) and hashlib.sha256(y.encode()).hexdigest()==wfsha
    and isinstance(d.get("jobs"),dict) and list(d["jobs"])==[job]
    and isinstance(d.get("jobs_list"),list) and len(d["jobs_list"])==1
    and isinstance(d["jobs_list"][0],dict) and d["jobs_list"][0].get("job_id")==job)
sys.exit(0 if ok else 1)' "$1" "$2" "$SHA" "$3" "$REPO" "$WF" "$WF_SHA" "$JOB"; }

if [ "${1:-}" = --cleanup ]; then
  D=$2; L=$D/supervisor.log; SINCE=$(cat "$D/since-utc.txt")
  V=0
  RUN=$(cat "$D/run-id.txt" 2>/dev/null); CHECK=$(cat "$D/check-id.txt" 2>/dev/null)
  if [ -f "$D/post-attempted" ]; then
    if [[ $RUN =~ $UUID_RE ]] && [ -f "$D/run-verified" ]; then
      if [ "$(b 3 systemctl --user is-active forgehold-lane-b3.service)" = active ]; then
        napi 10 "/api/v1/runs/$RUN" "$D/run-final.json" || { log "final run record UNKNOWN"; V=1; }
        napi 30 "/api/v1/runs/$RUN/logs?job=$JOB" "$D/job.log" || { log "job log UNKNOWN"; V=1; }
        st=$(python3 -I -c 'import json,sys; print(json.load(open(sys.argv[1])).get("status",""))' "$D/run-final.json" 2>/dev/null)
        if ! [[ $st =~ ^(success|failure|skipped|cancelled)$ ]]; then
          pl_cancel 10 "$RUN" >> "$L" 2>&1; log "scoped cancel of verified own run $RUN rc=$? (status was ${st:-unread})"
        fi
      else log "engine already stopped; own run $RUN not read or cancelled (UNKNOWN)"; V=1; fi
    else log "CANCELLATION UNCERTAIN: POST attempted but no ownership-verified run id; nothing cancelled"; V=1; fi
  fi
  b 25 systemctl --user stop forgehold-lane-b3.socket forgehold-lane-b3.service >> "$L" 2>&1; log "stop units rc=$?"
  for u in forgehold-lane-b3.service forgehold-lane-b3.socket; do
    s=$(b 3 systemctl --user is-active "$u"); log "unit $u: ${s:-unread}"; case $s in inactive|failed) ;; *) V=1 ;; esac
  done
  p=$(b 3 systemctl --user show -p MainPID --value forgehold-lane-b3.service); prc=$?
  log "service MainPID=${p:-unread} rc=$prc"; [ "$prc" = 0 ] && [ "$p" = 0 ] || V=1
  ok=; for i in 1 2 3; do
    j=$(pl_machines 8 2>>"$L"); rc=$?
    if [ $rc = 0 ] && printf '%s' "$j" | empty_json_list; then ok=1; break; fi; sleep 2
  done
  [ -n "$ok" ] && log "private registry empty" || { log "private registry NOT verified empty (rc=$rc)"; V=1; }
  for c in 'libkrun VM' preloop smolvm-bin; do x=$(present "$c"); log "own process '$c' present=$x"; [ "$x" = 0 ] || V=1; done
  b 5 $SCAN detail 'libkrun VM' > "$D/libkrun-after.jsonl" 2>>"$L"; log "libkrun after cleanup (own/foreign detail): rc=$?"
  b 3 ss -ltn > "$D/listeners.txt" 2>&1; rc=$?
  if [ $rc != 0 ]; then log "listener read failed rc=$rc"; V=1
  elif grep -Eq '(127\.0\.0\.1|0\.0\.0\.0|\[::\]|\*):9090 ' "$D/listeners.txt"; then log "port 9090 still listening"; V=1
  else log "no 127.0.0.1:9090 listener"; fi
  if [ -e "$PH/.preloop/preloop.sock" ]; then log "control socket still present"; V=1; else log "no control socket"; fi
  [ -d "$PERMIT" ] && log "permit consumed and retained" || log "permit not consumed"
  journal 10 > "$D/journal.txt" 2>>"$L"
  if [[ $CHECK =~ ^[0-9]{1,20}$ ]]; then
    b 10 gh api "repos/example-owner/$REPO/check-runs/$CHECK" > "$D/check-run.json" 2>>"$L" || log "check-run read failed (UNKNOWN)"
  fi
  pl_machines 8 > "$D/machines-after.json" 2>>"$L"
  [ "$V" = 0 ] && { log "cleanup verified"; exit 0; }
  log "CLEANUP VERIFICATION FAILED"; exit 20
fi

if [ "${1:-}" = --episode ]; then
  D=$2; L=$D/supervisor.log; SINCE=$(cat "$D/since-utc.txt")
  fail() { log "EPISODE STOP: $2"; exit "$1"; }
  not_expired() { [ "$(date -u +%s)" -lt "$EXPIRY" ] || fail 18 "owner grant expired"
    [ -f "$PH/fh-b3-control/expiry-permit" ] && [ ! -L "$PH/fh-b3-control/expiry-permit" ] && [ "$(cat "$PH/fh-b3-control/expiry-permit")" = "$EXPIRY" ] || fail 18 "effective expiry-permit is not $EXPIRY"; }
  scan() { local out hit; out=$(journal "$1") || fail 17 "journal unreadable"
           hit=$(printf '%s' "$out" | grep -m1 -o -E "$STOPS"); [ -z "$hit" ] || fail 16 "journal stop signal [$hit]"; }
  vmcap() { local n; n=$(vm_count); [ "$n" != 99 ] || fail 17 "libkrun process read failed"; [ "$n" -le 1 ] || fail 16 "own libkrun VM count $n > 1"; }
  left() { local r=$(( $1 - SECONDS )); [ "$r" -gt "$2" ] && r=$2; echo "$r"; }

  not_expired
  [ ! -e "$PERMIT" ] || fail 10 "create permit already consumed before start"
  RD=$((SECONDS + 180))
  log "start socket+service"
  b 30 systemctl --user start forgehold-lane-b3.socket forgehold-lane-b3.service >> "$L" 2>&1 || fail 10 "unit start refused or failed (StartLimit or other; not retried)"
  until out=$(journal "$(left $RD 15)") && printf '%s' "$out" | grep -q 'on-demand runner pool (size=0)'; do
    [ "$SECONDS" -lt "$RD" ] || fail 11 "readiness not reached within 180 s"
    scan "$(left $RD 15)"; sleep 2
  done
  printf '%s' "$out" | grep -q '"max_concurrent":1' || fail 11 "max_concurrent is not 1"
  until pl_status "$(left $RD 20)" > "$D/status-ready.json" 2>>"$L" \
        && python3 -I -c 'import json,sys; d=json.load(open(sys.argv[1])); labels=d["pool"]["labels"]; sys.exit(0 if isinstance(labels,list) and all(isinstance(v,str) for v in labels) and {"x64","forgehold"} <= {v.lower() for v in labels} else 1)' "$D/status-ready.json" \
        && [ "$SECONDS" -lt "$RD" ]; do
    [ "$SECONDS" -lt "$RD" ] || fail 11 "no status snapshot with X64 pool labels within 180 s of the start"
    sleep 2
  done
  log "status snapshot shows X64 pool labels"
  RCODE=$( { printf 'Authorization: Bearer '; b 10 secret-tool lookup service preloop username "$REF"; printf '\n'; } \
    | b 20 curl -sS -m 20 -o "$D/runs-pre.json" -w '%{http_code}' -H @- -H 'Accept: application/json' \
        'http://127.0.0.1:9090/api/v1/runs?limit=200' 2>>"$L"); RRC=$?
  log "recovered-work read rc=$RRC http=${RCODE:-none}"
  [ "$RRC" = 0 ] && [ "$RCODE" = 200 ] || fail 12 "recovered-work run list unreadable"
  python3 -I -c 'import json,sys; d=json.load(open(sys.argv[1])); assert isinstance(d,list)
bad=[x.get("run_id") for x in d if x.get("status") in ("queued","pending","in_progress")]
print(" ".join(map(str,bad))); sys.exit(1 if bad or len(d)>=200 else 0)' "$D/runs-pre.json" > "$D/runs-pre-nonterminal.txt" 2>>"$L" \
    || fail 12 "recovered or capped engine work present before dispatch: $(cat "$D/runs-pre-nonterminal.txt")"
  scan 15
  j=$(pl_machines 20 2>>"$L") && printf '%s' "$j" | empty_json_list || fail 12 "private registry not verified empty"
  j=$(lab_machines 20 2>>"$L") || fail 12 "lab registry unreadable"
  lab=$(printf '%s' "$j" | $SCAN lab "$NAME") || fail 12 "lab registry has $NAME or is not a list"
  log "lab registry (foreign, tolerated): $lab"
  [ "$(vm_count)" = 0 ] || fail 12 "an own libkrun VM is running (or unreadable) before the POST"
  log "foreign libkrun VMs (tolerated): $(vm_foreign)"
  m=$(awk '/^MemAvailable:/ {print $2}' /proc/meminfo); [[ $m =~ ^[0-9]+$ ]] && [ "$m" -ge 4718592 ] || fail 12 "MemAvailable ${m:-unread} kB below 4718592"
  ok=0
  for i in $(seq 1 60); do
    hot= r=
    for t in /sys/class/thermal/thermal_zone*/temp; do
      v=$(cat "$t") && [[ $v =~ ^[0-9]+$ ]] || fail 12 "thermal read failed: $t"; r="$r${r:+,}$v"; [ "$v" -lt 85000 ] || hot=1
    done
    log "thermal sample $i: $r"
    if [ -z "$hot" ]; then ok=$((ok+1)); [ "$ok" -ge 3 ] && break; else ok=0; fi
    sleep 1
  done
  [ "$ok" -ge 3 ] || fail 12 "thermal not below 85000 for 3 consecutive 1 s readings within 60 s (last $r)"
  log "memavail_kb=$(awk '/MemAvailable/ {print $2}' /proc/meminfo) free_GiB=$(df -B1G --output=avail /home | tail -1 | tr -d ' ')"
  log "psi_memory: $(tr '\n' ' ' < /proc/pressure/memory 2>/dev/null) oom_kill=$(awk '/oom_kill/ {print $2}' /proc/vmstat)"
  r=$(b 20 gh api "repos/example-owner/$REPO/git/ref/heads/$GREF" --jq .object.sha) && [ "$r" = "$SHA" ] || fail 12 "ref heads/$GREF not verified at the input commit"
  b 20 gh api "repos/example-owner/$REPO/contents/.github/workflows/$WF?ref=$SHA" --jq .content > "$D/workflow.b64" 2>>"$L" || fail 12 "workflow file unreadable at the commit"
  python3 -I -c 'import base64,sys; open(sys.argv[2],"wb").write(base64.b64decode(open(sys.argv[1]).read()))' "$D/workflow.b64" "$D/workflow.yml" || fail 12 "workflow decode"
  $WFC check "$D/workflow.yml" "$JOB" "$WF_SHA" 2>>"$L" || fail 12 "workflow at the commit is not the agreed single-job subset (sha256/job/trigger/labels)"
  log "workflow $WF at $SHA verified (sha256 $WF_SHA)"
  h=$(b 60 sha256sum < "$PACK" | cut -d' ' -f1) && [ "$h" = 53dd635842d6bcc7e5c2600b187cfe0863ba7888206aaf7ac848af5a812760b7 ] || fail 12 "pack hash not verified"
  [ ! -e "$PERMIT" ] || fail 12 "permit consumed before the POST"
  not_expired
  TPOST=$SECONDS; CD=$((TPOST + 60)); RGD=$((TPOST + 300))
  python3 -I -c 'import json,sys; print(json.dumps({"ref": "refs/heads/" + sys.argv[1]}))' "$GREF" > "$D/dispatch-request.json" || fail 12 "dispatch body not written"
  : > "$D/post-attempted" || fail 13 "post-attempted marker not writable; POST not sent"
  log "POST (single attempt; never retried)"
  code=$({ printf 'Authorization: Bearer '; b 10 secret-tool lookup service preloop username "$REF"; printf '\n'; } \
    | b 40 curl -sS -m 30 -o "$D/dispatch-body.txt" -w '%{http_code}' -H @- -H 'Accept: application/vnd.github+json' \
        -H 'Content-Type: application/json' -X POST --data @"$D/dispatch-request.json" \
        "http://127.0.0.1:9090/repos/example-owner/$REPO/actions/workflows/$WF/dispatches" 2>> "$L")
  log "POST http=${code:-none}"; [ "$code" = 204 ] || fail 13 "POST not accepted"
  RUN= CHECK=
  until [ -n "$CHECK" ]; do
    [ "$SECONDS" -lt "$CD" ] || fail 14 "no check run within 60 s of POST start"
    vmcap; out=$(journal "$(left $CD 15)") || fail 17 "journal unreadable"
    hit=$(printf '%s' "$out" | grep -m1 -o -E "$STOPS"); [ -z "$hit" ] || fail 16 "journal stop signal [$hit]"
    line=$(printf '%s' "$out" | grep -m1 'GitHub check run created successfully')
    if [ -n "$line" ]; then
      r=$(printf '%s' "$line" | python3 -I -c 'import json,sys; print(json.loads(sys.stdin.read())["fields"]["run_id"])' 2>/dev/null)
      c=$(printf '%s' "$line" | python3 -I -c 'import json,sys; print(json.loads(sys.stdin.read())["fields"]["check_run_id"])' 2>/dev/null)
      [[ $r =~ $UUID_RE ]] && [[ $c =~ ^[0-9]{1,20}$ ]] || fail 14 "unparseable run/check id"
      [ "$SECONDS" -lt "$CD" ] || fail 14 "check id obtained after the 60 s deadline; not accepted"
      napi 10 "/api/v1/runs/$r" "$D/run-candidate.json" || fail 14 "candidate run record unreadable"
      owned "$D/run-candidate.json" "$r" "$D/runs-pre.json" || fail 16 "check-created run $r is not this submission (repo/workflow/sha/workflow bytes/jobs/pre-existing); not adopted, never cancelled"
      echo "$r" > "$D/run-id.txt" && echo "$c" > "$D/check-id.txt" && : > "$D/run-verified" || fail 14 "run/check id not recorded"
      RUN=$r CHECK=$c; log "run=$RUN check=$CHECK (ownership verified)"
    else sleep 2; fi
  done
  REG=
  while :; do
    vmcap
    [ -d "$PERMIT" ] && [ ! -e "$D/permit-logged" ] && { : > "$D/permit-logged"; log "permit consumed (create forwarded once)"; }
    if [ -z "$REG" ]; then
      [ "$SECONDS" -lt "$RGD" ] || fail 15 "no runner registration within 300 s of POST start"
      out=$(journal "$(left $RGD 15)") || fail 17 "journal unreadable"
      if printf '%s' "$out" | grep -F '"ephemeral runner ready"' | grep -q -F "\"machine\":\"$NAME\"" && [ "$SECONDS" -lt "$RGD" ]; then
        REG=journal; log "runner $NAME ready $((SECONDS - TPOST)) s after POST start (journal)"
      elif pl_status "$(left $RGD 20)" > "$D/status-now.json" 2>/dev/null \
           && python3 -I -c 'import json,sys; r=json.load(open(sys.argv[1]))["runners"]; sys.exit(0 if r["registered"] + r["busy"] > 0 else 1)' "$D/status-now.json" \
           && [ "$SECONDS" -lt "$RGD" ]; then
        REG=status; cp "$D/status-now.json" "$D/status-registered.json"; log "runner registered $((SECONDS - TPOST)) s after POST start (status)"
      fi
      echo "$REG" > "$D/registration.txt"
    fi
    if [ -z "$REG" ]; then JC=$(left $RGD 15); GC=$(left $RGD 20); else JC=15; GC=20; fi
    [ -n "$REG" ] || [ "$SECONDS" -lt "$RGD" ] || fail 15 "no runner registration within 300 s of POST start"
    st=$(b "$GC" gh api "repos/example-owner/$REPO/check-runs/$CHECK" --jq '"\(.status)/\(.conclusion)"' 2>>"$L")
    case $st in completed/*) ;; *)
      out=$(journal "$JC") || fail 17 "journal unreadable"
      hit=$(printf '%s' "$out" | grep -m1 -o -E "$STOPS"); [ -z "$hit" ] || fail 16 "journal stop signal [$hit]"
      [ -n "$REG" ] || [ "$SECONDS" -lt "$RGD" ] || fail 15 "no runner registration within 300 s of POST start" ;;
    esac
    own=$(vm_count)
    if [ "$own" = 1 ] && [ ! -e "$D/libkrun-during.jsonl" ]; then
      b 5 $SCAN detail 'libkrun VM' > "$D/libkrun-during.jsonl" 2>>"$L"; drc=$?
      dn=$(grep -c '"own": true' "$D/libkrun-during.jsonl" 2>/dev/null)
      [ "$drc" = 0 ] && [ "$dn" = 1 ] && log "libkrun detail recorded (own in detail=1)" || log "libkrun detail rc=$drc own in detail=${dn:-unread}: classification link UNKNOWN"
    fi
    log "check=${st:-unread} libkrun_own=$own foreign=$(vm_foreign) memavail_kb=$(awk '/MemAvailable/ {print $2}' /proc/meminfo) psi_some_avg10=$(awk '/^some/ {print $2}' /proc/pressure/memory 2>/dev/null)"
    case $st in
      completed/success)
        [ -n "$REG" ] || fail 15 "check succeeded without observed registration in the window"
        [ -d "$PERMIT" ] || fail 15 "check succeeded but the create permit was not consumed"
        log "check completed success"; exit 0 ;;
      completed/*) fail 16 "check completed $st" ;;
    esac
    if [ -z "$REG" ]; then
      [ "$SECONDS" -lt "$RGD" ] || fail 15 "no runner registration within 300 s of POST start"
      sleep "$(left $RGD 10)"
      [ "$SECONDS" -lt "$RGD" ] || fail 15 "no runner registration within 300 s of POST start"
    else sleep 10; fi
  done
fi

D=${1:?evidence dir}
[ -d "$D" ] && [ -z "$(ls -A "$D")" ] || { echo "evidence dir must exist and be empty"; exit 2; }
L=$D/supervisor.log
[ "$(head -1 "$HOLD" 2>/dev/null)" = "FH_B3_HOLD token=$TOKEN INITIAL_INCOMPLETE" ] || { log "REFUSED: custody HOLD for this token missing or not initial"; exit 2; }
[ ! -e "$ZHOLD" ] || { log "REFUSED: Example project lane HOLD record exists ($ZHOLD)"; exit 2; }
NOW=$(date -u +%s); BUDGET=$(( EXPIRY - 120 - NOW )); [ "$BUDGET" -gt 450 ] && BUDGET=450
if [ "$BUDGET" -lt 450 ]; then log "REFUSED: only $BUDGET s left before the owner expiry; no start"; exit 2; fi
date -u '+%Y-%m-%d %H:%M:%S' > "$D/since-utc.txt" || exit 2
log "outer start; episode budget ${BUDGET}s; cleanup budget 240 s (+5 s kill)"
CHILD= ERC=1 CLEANED=
cleanup_once() {
  [ -n "$CLEANED" ] && return; CLEANED=1
  trap '' INT TERM
  if [ -n "$CHILD" ] && kill -0 "$CHILD" 2>/dev/null; then
    kill -TERM "$CHILD" 2>/dev/null; for i in $(seq 1 15); do kill -0 "$CHILD" 2>/dev/null || break; sleep 1; done
    kill -KILL "$CHILD" 2>/dev/null; wait "$CHILD" 2>/dev/null
  fi
  timeout -k 5 240 bash "$0" --cleanup "$D"; CRC=$?
  log "cleanup exit $CRC (124/137 = cleanup budget exceeded)"
  if [ "$CRC" != 0 ]; then FINAL=20; else FINAL=$ERC; fi
  case $ERC in 0|1[0-8]) ;; *) log "unexpected episode exit $ERC" ;; esac
  $CUST append "$HOLD" "{\"token\":\"$TOKEN\",\"by\":\"supervisor\",\"episode\":$ERC,\"cleanup\":$CRC,\"final\":$FINAL,\"signal\":\"${SIG:-none}\"}" 2>>"$L" \
    || { log "HOLD classification NOT written (custody failure)"; FINAL=21; }
  log "FINAL exit $FINAL"; exit "$FINAL"
}
trap cleanup_once EXIT
SIG=
trap 'SIG=INT; log "outer received SIGINT"; ERC=19; exit 19' INT
trap 'SIG=TERM; log "outer received SIGTERM"; ERC=19; exit 19' TERM
timeout -s TERM -k 10 "$BUDGET" bash "$0" --episode "$D" & CHILD=$!
wait "$CHILD"; ERC=$?
log "episode exit $ERC (124 = episode budget timeout)"
exit "$ERC"
